# -----------------------------------------------------------------------------
# SUPPLYCO COLLECTION & SALES MANAGEMENT - ENVIRONMENT VARIABLES TEMPLATE
# Copy these values into a .env file locally or set them in your Vercel Dashboard
# -----------------------------------------------------------------------------

# 1. DATABASE CONNECTION
# - Locally, use SQLite: file:./dev.db
# - In production on Vercel, replace with your hosted PostgreSQL connection string (Neon / Supabase / Railway)
# Example PostgreSQL: postgresql://postgres:your-strong-password@db.supabase.co:5432/postgres
DATABASE_URL="file:./dev.db"

# 2. JWT TOKEN SECURITY
# - A strong, random string used to sign user cookies session tokens.
# - You can generate one via command line: openssl rand -base64 32
JWT_SECRET="smart-shop-secret-super-secure-key-10928374"

# 3. VERCEL BLOB STORAGE (Production Only)
# - Injected automatically by Vercel when you add Vercel Blob Storage integration.
# - Offline fallback: If this token is NOT configured, local uploads in public/uploads will be used.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
